# PhishX Staging Environment Variables
# DevOps Agent: AI Co-worker
# Copy to .env.staging and fill in real values
# Never commit .env.staging to the repository

# ── Environment ──────────────────────────────────────────────────
ENVIRONMENT=staging
DEBUG=false
ENABLE_SWAGGER=false

# ── Domain ───────────────────────────────────────────────────────
STAGING_DOMAIN=staging.phishx.io
NEXT_PUBLIC_API_URL=https://api.staging.phishx.io

# ── Database (use separate staging DB — never share with prod) ───
POSTGRES_USER=phishx_staging
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=phishx_staging
DATABASE_URL=postgresql://phishx_staging:CHANGE_ME@postgres:5432/phishx_staging

# ── Redis ─────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/2

# ── Security ──────────────────────────────────────────────────────
API_KEY=CHANGE_ME_API_KEY_MIN_32_CHARS
SECRET_KEY=CHANGE_ME_SECRET_KEY_MIN_32_CHARS
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE=15
JWT_REFRESH_TOKEN_EXPIRE=30
ENABLE_JWT_AUTH=true
ENCRYPTION_ENABLED=true
ENCRYPTION_MASTER_KEY=CHANGE_ME_BASE64_32_BYTE_KEY

# ── CORS (staging frontend URL only — NOT wildcard) ───────────────
CORS_ORIGINS=https://staging.phishx.io

# ── Observability ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ── Feature flags ─────────────────────────────────────────────────
ENABLE_CIRCUIT_BREAKERS=true
ANOMALY_DETECTION_ENABLED=true
ASYNC_PROCESSING=true
ENABLE_ML_MODELS=true
